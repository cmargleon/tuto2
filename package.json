{
  "name": "auto2-catalog-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "MVP local para generar y revisar fotos de catalogo con fal.ai Seedream 4.5 + Node.js + Express.",
  "main": "dist/server/app.js",
  "scripts": {
    "dev": "tsx watch src/server/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/app.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.1.0",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "mime-types": "^2.1.35",
    "multer": "^2.1.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
