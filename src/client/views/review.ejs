<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Revision de catalogo - <%= product.productId %></title>
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body data-product-id="<%= product.productId %>">
    <% const explicitSelections = Object.values(product.approved).reduce((sum, ids) => sum + ids.length, 0); %>
    <% const readyPoseCount = product.poses.filter((pose) => product.outputs.some((output) => output.poseId === pose.poseId && output.status === "ready")).length; %>
    <div class="dashboard-layout">
      <%- include("partials/dashboard-sidebar", {
        activeMenu: "home",
        isSidebarCollapsed: false,
        product,
        currentIndex,
        allProducts,
        basename,
        fileUrl,
        explicitSelections
      }) %>

      <main class="dashboard-content content">
        <%- include("partials/topbar-main") %>
        <%- include("partials/topbar-nav", { previous, next }) %>

        <section class="poses">
          <% for (const pose of product.poses) { %>
            <%- include("partials/pose-card", { pose, product, fileUrl }) %>
          <% } %>
        </section>
      </main>
    </div>

    <%- include("partials/floating-actions", { readyPoseCount }) %>

    <script>
      window.__PAGE_MODEL__ = {
        productId: "<%= product.productId %>",
        page: "home",
        previous: <%- JSON.stringify(previous) %>,
        next: <%- JSON.stringify(next) %>,
        productStatus: "<%= product.status %>",
        canFinalize: <%= readyPoseCount === 4 ? "true" : "false" %>,
        shouldPoll: <%= (product.status === "pending" || product.status === "generating") ? "true" : "false" %>,
        signature: <%- JSON.stringify(JSON.stringify({
          status: product.status,
          outputs: product.outputs.map((output) => ({
            outputId: output.outputId,
            poseId: output.poseId,
            filePath: output.filePath
          })),
          approved: product.approved,
          poses: product.poses.map((pose) => ({
            poseId: pose.poseId,
            status: pose.status
          }))
        })) %>
      };
    </script>
    <script src="/assets/app.js"></script>
  </body>
</html>
